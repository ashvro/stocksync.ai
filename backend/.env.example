# Copy to .env and fill in real values. backend/.env is gitignored.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional — when set, uses this persistent database (e.g. Render's Postgres)
# instead of the local SQLite file. Example:
# DATABASE_URL=postgres://user:pass@host:5432/asfootwear

# Admin console credentials (server-side)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345

# ASbot AI (get a key at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
